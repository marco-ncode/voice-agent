# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- apps/dashboard (see apps/dashboard/.env.local.example for local dev) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- apps/api ---
API_PORT=8080
API_JWT_SECRET=change-me

# --- LLM providers ---
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# --- STT providers ---
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- TTS providers ---
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# --- Local inference service (services/inference) ---
# Required for any agent using "local" as LLM/STT/TTS provider, AND for RAG
# (document ingestion + retrieval use EmbeddingGemma served from here).
INFERENCE_SERVICE_URL=http://localhost:8000
INFERENCE_SERVICE_API_KEY=change-me
