{
  "name": "@v-agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "predev": "pnpm --filter @v-agent/shared --filter @v-agent/db --filter @v-agent/providers build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "@v-agent/db": "workspace:*",
    "@v-agent/providers": "workspace:*",
    "@v-agent/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^6.3.289",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
